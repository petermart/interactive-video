# Copy to .env for local use, or set these as Railway variables in deployment.
# .env is gitignored. Never commit real values.

# --- Cloudflare R2: where generated media lives in deployment ------------------
# Leave these blank locally and everything stays on disk exactly as before.
#
# Create them at: Cloudflare dashboard > R2 > Manage API Tokens > Create API Token
#   - Permission: "Object Read & Write"
#   - Scope it to the single bucket below, not the whole account.
# The account id is on the R2 overview page (it is also the first part of the S3 endpoint).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=slop-prison-media

# Optional: set instead of R2_ACCOUNT_ID if you have the full S3 endpoint.
# R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# --- Server ------------------------------------------------------------------
# Writable state that is NOT media: the debug SQLite database and settings.json.
STORAGE_DIR=/data
PORT=3000

# Public origin, used to hand out frame URLs external generators can fetch.
# Railway sets RAILWAY_PUBLIC_DOMAIN itself, so this is only needed elsewhere.
# PUBLIC_BASE_URL=https://example.up.railway.app

# --- Sign-in (Better Auth) ----------------------------------------------------
# Leave blank and the sign-in gate stays open: nobody is asked to sign in for something
# that cannot work. Set the guest policy in the admin panel once these are filled in.
#
# Signs sessions and guest cookies. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Google: console.cloud.google.com > APIs & Services > Credentials > OAuth client ID (Web).
# Authorised redirect URI: https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook: developers.facebook.com > your app > Facebook Login > Settings.
# Valid OAuth redirect URI: https://<your-domain>/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Apple is deliberately not wired up: Sign in with Apple needs a paid Apple Developer
# account ($99/yr). Adding it later is configuration in src/server/auth.ts, not rework.

# --- Analytics ----------------------------------------------------------------
# Cloudflare Web Analytics: dash.cloudflare.com > Analytics & Logs > Web Analytics >
# Add a site. Copy the token out of the snippet it gives you.
# NOT a secret — it ships in the HTML of every page and identifies the site only.
# Leave blank locally so development traffic is not counted.
CF_ANALYTICS_TOKEN=

# --- API keys ----------------------------------------------------------------
# Locally these come from keys.json (gitignored) instead; environment variables win.
MACHGEN_API_KEY=
GMI_API_KEY=
# MASKY_API_KEY=
# ELEVENLABS_API_KEY=
